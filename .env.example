# MyChat environment. Copy this file to `.env` and fill in the values.
# Only this example is versioned: `.env` holds real secrets and never is.
# Every key is listed with no value on purpose. A blank value counts as unset,
# so keys that have a default can simply stay blank. Docker Compose reads this
# same file with `env_file`; its database and disk-storage paths are fixed by
# docker-compose.yml to the persistent `mychat-data` volume, never this folder.

# Meta platform credentials.
# META_APP_SECRET and WEBHOOK_VERIFY_TOKEN are REQUIRED: without them the
# webhook can neither answer the platform's verification nor authenticate a
# delivery, so the process refuses to start instead of serving in a state it
# cannot honour.
# META_APP_SECRET validates the webhook signature.
# WEBHOOK_VERIFY_TOKEN answers the platform's initial webhook verification.
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=

# META_ACCESS_TOKEN and INSTAGRAM_ACCOUNT_ID are OPTIONAL: a fresh installation
# has neither, and the process starts anyway so `npm run cli status` can tell
# you what is still missing. Both together configure the platform credential.
# META_ACCESS_TOKEN authorises calls to the platform API (docs/meta-app-setup.md
# step 7 generates it).
# INSTAGRAM_ACCOUNT_ID is the account's own id, the `<ig-id>` of
# `/<ig-id>/messages`. It is the `entry[].id` of every webhook payload the
# platform sends you, and what `GET /me?fields=id` returns for your token.
# They are read ONLY to seed the credential the first time: once stored, the
# automatic renewal owns the token, and a restart never overwrites it.
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Lifetime assumed for the token above when it is first stored, in
# milliseconds. The platform does not report when an already issued token
# expires, so the seed counts from the instant it was stored: sixty days, the
# documented life of a long-lived Instagram Login token (ADR-021). The first
# automatic renewal replaces this estimate with the platform's own number.
# Shorten it if the token you are pasting is already some days old.
# Default: 5184000000 (60 days).
TOKEN_LIFETIME_MS=

# Port the process listens on. Default: 3000
PORT=

# Where the PLATFORM reaches this process: a tunnel address in development, a
# domain in production. Every resource URL sent to a contact is built from it,
# so a wrong value produces links that lead nowhere with no error on our side.
# Default: http://localhost:<PORT>
PUBLIC_ORIGIN=

# Language the interface, the terminal and the audit trail start in. One value
# per catalogue this build carries: `en` or `pt-BR`. It is the INITIAL value
# only: once a language is chosen in the panel, that choice wins on every start
# and this key is never consulted again. An unknown value is not an error, it
# simply leaves the default in force. Default: en
MYCHAT_LOCALE=

# Time zone the panel counts and labels in. An IANA name (`America/Sao_Paulo`,
# `Europe/Lisbon`) or `UTC`. It is NOT only the wording of a label: the panel
# groups events by hour and by day IN THIS ZONE, so an event at 22:00 local
# belongs to the local day it happened on rather than to the next UTC one.
# There is one instance per operated account (ADR-023), so this is a decision of
# the instance and not a preference per person. A name this build's calendar
# data does not know is REFUSED at start-up, naming the variable: a typo would
# otherwise file every number under a zone nobody chose. It is the INITIAL value
# only: the zone is changeable in Settings, that choice wins on every later
# read, and it takes effect with no restart. Default: UTC
MYCHAT_TIMEZONE=

# SQLite database file. Default: ./dev-data/mychat.db
DATABASE_PATH=

# Asset storage: `disk` keeps files on the local filesystem (development
# default), `s3` targets an S3-compatible bucket (Cloudflare R2 in
# production). Default: disk
STORAGE_DRIVER=

# Used only when STORAGE_DRIVER=disk. Default: ./dev-data/assets
ASSETS_DIR=

# Where the publication thumbnails the panel shows are kept, also only when
# STORAGE_DRIVER=disk. They are copies this application downloads (the
# platform's own image addresses expire), and they are served at /thumbs, so
# this directory is what the grid reads its pictures from. Keep it OUT of
# ASSETS_DIR: that one is the catalogue an automation delivers from.
# Default: ./dev-data/thumbs
THUMBNAILS_DIR=

# How often the durable-work sweep looks for sends and suspensions that are
# due, in milliseconds. This is a latency budget, not a platform limit: a
# contact waits at most this long past a due instant. Default: 5000
SWEEP_INTERVAL_MS=

# How often the platform credential is checked, and how long before expiry a
# renewal is attempted, both in milliseconds. Operational choices, not platform
# numbers. Ten days inside a sixty-day token means roughly forty chances to
# renew before it dies, so one transient failure is nowhere near fatal.
# Defaults: 21600000 (6 hours) and 864000000 (10 days).
CREDENTIAL_CHECK_INTERVAL_MS=
TOKEN_REFRESH_THRESHOLD_MS=

# Required only when STORAGE_DRIVER=s3, ignored otherwise. The bucket stays
# private: MyChat issues its own private links and short-lived S3 reads.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Platform limits. Each one has a built-in default, so leave a key blank unless
# you are overriding it. The confirmed value, the official source URL and the
# consultation date behind every default live in docs/platform-limits.md
# Defaults: 24 hours of direct-message window, 7 days of private-reply window,
# 750 private replies per hour (the only official hourly ceiling), 100 calls per
# second for text and links, 10 per second for audio and video, 5 retry
# attempts, 1000 ms of retry base delay. The last two are the dashboard's
# proximity thresholds: it signals attention at 80 percent of a cap and
# critical at 95 percent.
MESSAGE_WINDOW_HOURS=
COMMENT_REPLY_WINDOW_DAYS=
PRIVATE_REPLIES_PER_HOUR=
CALLS_PER_SECOND=
MEDIA_CALLS_PER_SECOND=
RETRY_ATTEMPTS=
RETRY_BASE_MS=
ALERT_THRESHOLD_PCT=
CRITICAL_THRESHOLD_PCT=

# Content ceilings, also from docs/platform-limits.md. MESSAGE_TEXT_BYTES is
# measured in BYTES of UTF-8, not characters: in Portuguese every accented
# character costs two, so a text that looks short can overflow. The two label
# ceilings belong to DIFFERENT mechanisms: a URL button lives in a generic
# template (80), a quick reply does not (20).
# The card ceilings belong to the generic template's element: a message with a
# link IS a card, and its text travels as that element's title, which is 80
# characters and not the 1000 bytes a text message accepts.
# Defaults: 1000 bytes, 80 characters, 20 characters, 80 characters, 80
# characters.
MESSAGE_TEXT_BYTES=
LINK_BUTTON_LABEL_CHARS=
QUICK_REPLY_LABEL_CHARS=
CARD_TITLE_CHARS=
CARD_DESCRIPTION_CHARS=

# Operator session cookie. `true` marks the cookie `secure`, so the browser
# only ever sends it over HTTPS; `false` lets it travel over plain HTTP. Leave
# it blank and it follows NODE_ENV: on in production, off anywhere else, which
# is what lets `npm run dev` work on http://localhost with no configuration at
# all. Setting it to `false` while NODE_ENV=production is REFUSED at start-up,
# and anything other than `true` or `false` is refused as an invalid value.
# Default: blank (follows NODE_ENV).
SESSION_COOKIE_SECURE=

# Ceiling on failed login attempts, counted per origin. There is one password
# and the login route is public, so this is what stops guessing in volume.
# Defaults: 5 attempts, a 900000 ms (15 minute) window in which failures
# accumulate, a 900000 ms (15 minute) block once the ceiling is crossed, and
# 10000 origins tracked at once. The last one is a memory bound, not a tuning
# knob: without it, an attacker with an IPv6 allocation could exhaust the host.
AUTH_ATTEMPT_LIMIT=
AUTH_ATTEMPT_WINDOW_MS=
AUTH_BLOCK_MS=
AUTH_TRACKED_ORIGINS=

# How many reverse proxies sit in front of this process. Default: 0, which
# means the address of the socket is used and the forwarded header is ignored.
# SET THIS TO 1 WHEN A REVERSE PROXY IS IN FRONT (Caddy, ADR-013), and this is
# the trap: with a proxy in front, every request arrives carrying the proxy's
# own address, so the ceiling above stops being per origin and becomes global.
# Anyone in the world typing a wrong password then locks the operator out of
# their own dashboard for 15 minutes.
# The opposite mistake costs just as much: declare a hop that is not there and
# the client writes the header itself, so it picks its own origin and the
# ceiling never counts the same one twice. Set it to what the deployment
# actually puts in front, and to nothing else.
AUTH_TRUSTED_PROXY_HOPS=
