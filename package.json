{
  "name": "mychat",
  "version": "0.0.0",
  "description": "Open source Instagram automation: declarative flows, self-hosted, no lock-in.",
  "license": "MIT",
  "author": "Alessandro Varela",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "MYCHAT_PUBLIC_RELEASE=1 vitest run",
    "build": "tsc --noEmit && vite build",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:web": "vite",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "cli": "tsx src/cli/bin.ts",
    "publish:public": "node scripts/public-publish.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.2",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.0",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  }
}
